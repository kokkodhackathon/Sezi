{
  "expo": {
    "name": "Sezi",
    "slug": "sezi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sezi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lahmacun.sezi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F4F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lahmacun.sezi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#111014",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sezi, sizi vakıf eserlerine yönlendirmek için konumunuzu kullanır."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-audio",
      "@rnmapbox/maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sezi, profil fotoğrafınızı seçmek için fotoğraflarınıza erişir.",
          "cameraPermission": "Sezi, profil fotoğrafı çekmek için kameranızı kullanır.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
