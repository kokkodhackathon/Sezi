# Mobil (Expo yalnızca EXPO_PUBLIC_ önekli değişkenleri istemciye açar)
EXPO_PUBLIC_SUPABASE_URL=https://jejsvycpzulpleftkssj.supabase.co
# Publishable key (sb_publishable_…); yoksa eski anon key okunur
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Mapbox public token (pk.…), account.mapbox.com → Tokens
EXPO_PUBLIC_MAPBOX_TOKEN=

# Admin (Vite)
VITE_SUPABASE_URL=https://jejsvycpzulpleftkssj.supabase.co
VITE_SUPABASE_ANON_KEY=
# Mapbox public token (pk.…); mobilde ayrı, admin için URL kısıtlı ayrı token önerilir
VITE_MAPBOX_TOKEN=

# Web (Next.js, apps/web/.env.local; NEXT_PUBLIC_ önekliler derlemede pakete gömülür, istemciye açıktır)
NEXT_PUBLIC_SUPABASE_URL=https://jejsvycpzulpleftkssj.supabase.co
# Publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_KEY=
# Mapbox public token (pk.…); web için sezi.info'ya URL kısıtlı ayrı token
NEXT_PUBLIC_MAPBOX_TOKEN=
# Sitenin tam adresi (sitemap, paylaşım kartları): yerelde http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://sezi.info

# Yalnızca psql / pipeline için, istemciye ASLA koymayın
SUPABASE_DB_URL=postgresql://postgres.jejsvycpzulpleftkssj:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
